; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Archipel des Cendres Tièdes"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/icon/icon.png"

[autoload]

Clock="*res://autoload/Clock.gd"
Rng="*res://autoload/Rng.gd"
SaveManager="*res://autoload/SaveManager.gd"

[display]

window/size/viewport_width=180
window/size/viewport_height=320
window/size/resizable=true
window/size/window_width_override=540
window/size/window_height_override=1260
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=1

[gui]

theme/custom="res://assets/ui/theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="mobile"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
