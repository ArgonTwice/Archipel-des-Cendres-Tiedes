[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/credits.gd" id="1"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_opaque"]
bg_color = Color(0.08, 0.08, 0.09, 1)

[node name="Credits" type="PanelContainer"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_opaque")
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 4
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 4
theme_override_constants/margin_bottom = 4

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2

[node name="Font" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Police : Silkscreen, Jason Kottke"
autowrap_mode = 3

[node name="Copyright" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Copyright 2001 The Silkscreen Project Authors"
autowrap_mode = 3

[node name="License" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "SIL Open Font License 1.1"
autowrap_mode = 3

[node name="Kenney" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Tuiles et personnages : Kenney (kenney.nl), CC0"
autowrap_mode = 3

[node name="Scroll" type="ScrollContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Text" type="Label" parent="Margin/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3

[node name="Close" type="Button" parent="Margin/VBox"]
layout_mode = 2
size_flags_horizontal = 0
text = "Fermer"
